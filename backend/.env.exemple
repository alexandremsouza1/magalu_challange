# JWT
JWT_SECRET="votre-secret-super-securise"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# Serveur
API_PORT=4000
NODE_ENV=developement
CORS_ORIGIN='https://yourdomain.com,https://www.yourdomain.com'
COOKIE_SECRET="votre-secret-super-securise"

# Spotify API
SPOTIFY_URL=https://api.spotify.com/v1
SPOTIFY_CLIENT_ID=sua-spotify-client-id
SPOTIFY_CLIENT_SECRET=sua-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4000/v1/auth/spotify/callback